# Validated once at boot by src/env.ts. Blank means unset; the API exits if a required var is unset.

# development, staging or production.
NODE_ENV=""
# Optional. Defaults to 8001.
PORT=""
DATABASE_URL=""

# At least 32 characters each. Access and refresh secrets must differ.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Optional. Honored when NODE_ENV is development or staging. Never a replacement for a session cookie when one is present.
MASTER_KEY=""
MASTER_TEST_EMAIL=""

ACCESS_TOKEN_KEY="voyageurs_access_token"
REFRESH_TOKEN_KEY="voyageurs_refresh_token"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Frontend origin + /api/login/google. Must match the frontend redirect URI and the Google Cloud client.
GOOGLE_REDIRECT_URIS=""

TRIPADVISOR_API_KEY=""
# Optional. Without it POST /geo finds nothing.
IPINFO_GEOLOCATION_API_KEY=""

# Optional. Hop count in front of the API (1 for a single ALB, nginx, or platform proxy), or "true".
# Leave unset locally. Set in deployed environments so req.ip is the visitor IP.
TRUST_PROXY=""
